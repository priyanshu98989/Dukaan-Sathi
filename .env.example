# ---------------------------------------------------------------------------
# Dukaan Sathi - environment variables
# Copy this file to `.env` and fill in real values. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# Google Gemini API key. Create one at https://aistudio.google.com/apikey
# This key is used ONLY on the server. It is never sent to the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/dukaan_sathi
# Atlas:          mongodb+srv://<user>:<pass>@<cluster>/dukaan_sathi
MONGODB_URI=mongodb://127.0.0.1:27017/dukaan_sathi

# Port the Express server listens on.
PORT=5000

# --- security ------------------------------------------------------------

# Shop key. REQUIRED. Every /api route except /api/health needs this, sent as
# the `X-API-Key` header (a `Authorization: Bearer <key>` token also works).
#
# The shopkeeper types it into the app once; the browser keeps it in
# sessionStorage. It is deliberately NOT baked into the client bundle, because
# anything in the JavaScript is readable by anyone who opens devtools.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Rotate it by changing this value and restarting the server.
#
# This is a single shared shop key, not per-user identity: no passwords, no
# sessions. Anyone holding the key has full access to this API.
API_KEY=your_shop_key_here

# Escape hatch for local poking only: set to true to run with NO key at all.
# Never do this on a machine reachable from the network.
API_KEY_ALLOW_ANONYMOUS=false

# Request budgets per minute, per device.
# The voice budget is the one that matters: every /api/voice/process is one
# billable Gemini call, so this is what stops a runaway client from spending the
# shop's money. The read budget is MongoDB-only and deliberately looser.
RATE_LIMIT_VOICE_MAX=20
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# --- optional -------------------------------------------------------------

# Gemini model used for transcription + intent extraction (must accept audio input).
# Must support audio input + structured outputs. The whole 2.5 family returns 404
# for newly created API keys, and the 3.x flagships are frequently 503 (high
# demand). gemini-flash-lite-latest is the stable rolling alias that is fastest,
# cheapest, and the most reliable at obeying "Roman script, no translation".
GEMINI_MODEL=gemini-flash-lite-latest

# Origin allowed to call the API in development.
CLIENT_ORIGIN=http://localhost:5173

# Confidence below this value triggers the "Haan / Nahi" confirmation flow.
CONFIDENCE_THRESHOLD=0.75

# Max accepted audio upload size in bytes (default 10 MB).
MAX_AUDIO_BYTES=10485760
